# ============================================================
# webman-curd-admin 插件 · 宿主 .env 数据库键参考（仅手动/CLI 部署参考）
#
# Web 安装向导（/app/curd-installer）安装成功时，会把下面 DB_* 自动写入宿主
# .env；自动生成的 config/database.php 用 env() 读取这些键。
# 手动部署：把本段抄进宿主 .env 填值后执行 php plugin/curd/install.php。
#
# ⚠️ 插件调参（page_base / admin_require_permission / 连接名…）不再走 .env：
#    统一写在宿主 config/curd-admin.php（composer require 时自动生成模板）。
# ⚠️ 单库架构：认证库与业务库【同一库】，已无 DB_BUSINESS_NAME / 分库选项。
# ============================================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webman_curd       # 库不存在时 install.php 会自动 CREATE
DB_USER=root
DB_PASSWORD=your_password

# ---- 可选：接口加密 ----
# 默认【开启】（dev / prod 一致），安装时自动生成 RSA 密钥对，开箱即用。
# 要关闭：写宿主 config/curd-admin.php 的 'api_encrypt' => false（优先级更高），
#        或下面这行 API_ENCRYPT=false，改完 restart。
# 关闭后前端会自动跟着退回明文，不需要重新打包前端。
# API_ENCRYPT=false
