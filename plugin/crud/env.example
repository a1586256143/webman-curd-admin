# ============================================================
# webman-crud 插件 · 环境变量模板
# 拷贝为项目根 .env 后填入你的真实值（本文件不进 git）
# 全部键均已接入 config('plugin.crud.crud.*') 与 config/database.php
# ============================================================

# ---- 数据库（主库 = 认证/管理面，admin_users/roles/menus/casbin...）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my_admin           # 认证库名
DB_USER=root
DB_PASSWORD=your_password

# ---- 业务库（可选；与认证库同实例可填同一库名）----
DB_BUSINESS_NAME=my_business

# ---- CRUD 插件调参（覆盖 config/plugin/crud/crud.php）----
# 认证库连接名（对应 config/database.php 的 connections 键）
CRUD_ADMIN_CONNECTION=mysql
# 业务库连接名
CRUD_BUSINESS_CONNECTION=mysql_business
# /api/admin/* 是否走 casbin 鉴权：生产建议 true，开发期 false
CRUD_ADMIN_REQUIRE_PERMISSION=false
# 前端挂载前缀（改了需同步重建前端：VITE_BASE_PATH）
CRUD_PAGE_BASE=/app/crud

# ---- 前端构建期变量（仅 build-frontend.sh 使用，运行期无效）----
# CRUD_FRONTEND_DIR=/path/to/crud-frontend   # 前端源码目录
# VITE_BASE_PATH=/app/crud/
# VITE_API_BASE_URL=                          # 留空=同域相对路径
# VITE_API_ENCRYPT=false                      # true 时需把 config/keys/api_rsa_public.pem 替换进前端后构建

# ---- 可选：传输加密（需先生成 RSA 密钥，见 install.php）----
# API_ENCRYPT=false
