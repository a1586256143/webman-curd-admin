{
  "name": "amcolin/webman-curd-admin",
  "type": "library",
  "description": "webman 应用插件（composer 分发版）：自包含的 CURD/DSL/Schema 页面引擎 + 登录/RBAC 中后台底座。内含 plugin/curd，宿主 composer require 后由 webman 官方插件安装器（workerman/webman-framework 的 support\\Plugin）自动调用本包 src/Install.php 拷贝到 {项目}/plugin/curd 开箱即用。",
  "keywords": [
    "webman",
    "plugin",
    "curd",
    "lowcode",
    "dsl",
    "admin",
    "rbac"
  ],
  "license": "MIT",
  "homepage": "https://gitee.com/colingit/webman-curd-admin",
  "authors": [
    {
      "name": "colin"
    }
  ],
  "support": {
    "source": "https://gitee.com/colingit/webman-curd-admin",
    "issues": "https://gitee.com/colingit/webman-curd-admin/issues"
  },
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "^2.1",
    "webman/database": "^2.1",
    "webman/redis": "^2.1",
    "casbin/casbin": "^4.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "extra": {
    "webman-app-plugin": "curd"
  },
  "autoload": {
    "psr-4": {
      "Amcolin\\WebmanCurdAdmin\\": "src/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
